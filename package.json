{
  "name": "agent-radio",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "tsx src/server/index.ts",
    "dev": "tsx watch src/server/index.ts",
    "cli": "tsx src/server/cli.ts",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "format": "biome format --write .",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "build": "vite build",
    "dev:client": "vite"
  },
  "dependencies": {
    "@hono/node-server": "^1.19.0",
    "@simplewebauthn/browser": "^14.0.0",
    "@simplewebauthn/server": "^14.0.3",
    "@tanstack/react-query": "^5.107.1",
    "better-sqlite3": "^12.0.0",
    "busboy": "^1.6.0",
    "drizzle-orm": "^0.45.4",
    "hono": "^4.13.14",
    "ipaddr.js": "^2.5.0",
    "lucide-react": "^1.73.0",
    "music-metadata": "^12.5.0",
    "qrcode": "^1.5.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^8.5.1",
    "tsx": "^4.20.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.4",
    "@types/better-sqlite3": "^7.6.13",
    "@types/busboy": "^1.5.5",
    "@types/node": "^24.0.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "drizzle-kit": "^0.31.11",
    "typescript": "^5.9.0",
    "vite": "^7.3.8",
    "vitest": "^3.2.0"
  }
}
