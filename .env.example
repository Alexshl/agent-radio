# Copy to .env (docker compose reads it). Never commit .env.

# Host port of the app. It listens on 127.0.0.1 only; BIND_ADDR=0.0.0.0 exposes it on the LAN (no TLS).
# BIND_ADDR=127.0.0.1
# Host port of the app. The old prototype used 8790, so 8791 is handy while both run.
PORT=8791
# This admin is created on first start (or: docker compose exec app npm run cli -- create-admin <email> <password>)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-at-least-12-chars
# Key for the stored cloud-TTS API keys (AES-GCM). Empty = generated once into the data volume (data/app-secret).
# APP_SECRET=

# Icecast passwords: any random strings (icecast and liquidsoap are internal to the compose network, no host ports)
ICECAST_SOURCE_PASSWORD=change-me-source
ICECAST_ADMIN_PASSWORD=change-me-admin

# Shared music library, mounted at /music: read-only into liquidsoap, read-write into the app (web uploads go to uploads/, deleted tracks to .trash/).
# The folder must be writable by uid 1000 (the node user of the app container).
MUSIC_DIR=/path/to/music

# Public base URL used in stream links (m3u, status)
# PUBLIC_URL=https://radio.example.com   (also used for the invite links and the Secure flag of the session cookie)

# TTS (provider: piper only for now; voice model is downloaded on first use into the data volume)
# TTS_PROVIDER=piper
# TTS_VOICE=uk_UA-mykyta-high
# TTS_LANG=uk
# Messages per API key per minute
# SAY_RATE_PER_MIN=10
# Stream bitrate in kbps (uploaded music files are encoded at 192k)
# STREAM_BITRATE=192
# Set to 1 when the app is behind a tunnel / reverse proxy (Cloudflare Tunnel): then CF-Connecting-IP / X-Forwarded-For is trusted for the login rate limit.
# Leave empty when the app port is reachable directly.
# TRUST_PROXY=1

# Local neural voices (optional, CPU only, several GB of models downloaded on first start; see README "Local voices").
# COMPOSE_PROFILES=local-tts
# Engines: styletts2 (Ukrainian, MIT), silero (Russian, CC BY-NC-SA: non-commercial use only), f5 (experimental, set TTS_LOCAL_F5=1)
# TTS_LOCAL_ENGINES=styletts2
# TTS_LOCAL_F5=0
# TTS_LOCAL_CPUS=6
# TTS_LOCAL_MEM=10g
# GPU voice server on another machine (same API as tts-local, protected with a Bearer token). Off or failing = the usual voice speaks.
# TTS_REMOTE_URL=http://gpu-host:8795
# TTS_REMOTE_TOKEN=
