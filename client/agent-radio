#!/bin/sh
# agent-radio: command line client of an agent-radio server (POSIX sh + curl; macOS and Linux).
#
#   agent-radio status                    listeners and the summary language to write in
#   agent-radio say "text"                speak a short summary (or: echo text | agent-radio say)
#   agent-radio say --wait "text"         the same, then wait (up to 60 s) and print "played" or "not played: <reason>"
#   agent-radio play file.mp3 ["intro"]   put an audio file on air (the intro is spoken before it)
#   agent-radio config                    show the server address and the masked key
#
# Config: ~/.config/agent-radio/env (AGENT_RADIO_URL, AGENT_RADIO_KEY; chmod 600). Environment variables win over the file.
# AGENT_RADIO_SESSION overrides the session label (default: name of the git root or of the current folder).
#
# It never breaks the agent: server unreachable, nobody listening, rate limited -> a one-line message and exit 0.
# Wrong key (401) or a rejected request -> an error and exit 1.
#
# JSON is built without hand-escaping when python3 or jq exists; otherwise a small sed/awk escaper is used
# (quotes, backslashes, tabs, newlines and carriage returns; other control characters are dropped; UTF-8 passes through).

CONF_FILE="${AGENT_RADIO_CONFIG:-${XDG_CONFIG_HOME:-$HOME/.config}/agent-radio/env}"

# KEY=VALUE lines are read, never sourced: nothing in the file is executed. Values may be single-quoted (a ' inside is written '\'').
unquote() {
  v=$1
  case $v in
    \'*\')
      v=${v#\'}
      v=${v%\'}
      v=$(printf '%s' "$v" | sed "s/'\\\\''/'/g")
      ;;
    \"*\")
      v=${v#\"}
      v=${v%\"}
      ;;
  esac
  printf '%s' "$v"
}

_file_url=""
_file_key=""
_file_session=""
if [ -r "$CONF_FILE" ]; then
  while IFS= read -r line || [ -n "$line" ]; do
    case $line in
      AGENT_RADIO_URL=*) _file_url=$(unquote "${line#*=}") ;;
      AGENT_RADIO_KEY=*) _file_key=$(unquote "${line#*=}") ;;
      AGENT_RADIO_SESSION=*) _file_session=$(unquote "${line#*=}") ;;
    esac
  done <"$CONF_FILE"
fi

# environment variables win over the file
AGENT_RADIO_URL="${AGENT_RADIO_URL:-$_file_url}"
AGENT_RADIO_KEY="${AGENT_RADIO_KEY:-$_file_key}"
AGENT_RADIO_SESSION="${AGENT_RADIO_SESSION:-$_file_session}"
AGENT_RADIO_URL="${AGENT_RADIO_URL%/}"

say_err() { printf 'agent-radio: %s\n' "$*" >&2; }

session_label() {
  if [ -n "${AGENT_RADIO_SESSION:-}" ]; then
    printf '%s' "$AGENT_RADIO_SESSION"
    return
  fi
  root=$(git rev-parse --show-toplevel 2>/dev/null) || root=""
  [ -n "$root" ] || root=$PWD
  basename "$root"
}

host_label() {
  h=$(hostname -s 2>/dev/null) || h=$(hostname 2>/dev/null) || h=""
  printf '%s' "${h:-unknown}"
}

# ---- JSON helpers -------------------------------------------------------------------------------

# AGENT_RADIO_JSON_TOOL=python3|jq|sh forces a tool (the tests use it)
if [ -n "${AGENT_RADIO_JSON_TOOL:-}" ]; then
  JSON_TOOL=$AGENT_RADIO_JSON_TOOL
elif command -v python3 >/dev/null 2>&1; then
  JSON_TOOL=python3
elif command -v jq >/dev/null 2>&1; then
  JSON_TOOL=jq
else
  JSON_TOOL=sh
fi

# json_say <session> <host> <text>
json_say() {
  case $JSON_TOOL in
    python3)
      python3 -c 'import json,sys; print(json.dumps({"session": sys.argv[1], "host": sys.argv[2], "text": sys.argv[3]}, ensure_ascii=False))' "$1" "$2" "$3"
      ;;
    jq)
      jq -n --arg s "$1" --arg h "$2" --arg t "$3" '{session: $s, host: $h, text: $t}'
      ;;
    *)
      printf '{"session":"%s","host":"%s","text":"%s"}\n' "$(esc "$1")" "$(esc "$2")" "$(esc "$3")"
      ;;
  esac
}

# minimal escaper for the sh fallback
esc() {
  printf '%s' "$1" | tr -d '\000-\010\013\014\016-\037' | sed -e 's/\\/\\\\/g' -e 's/"/\\"/g' -e "s/$(printf '\t')/\\\\t/g" |
    awk 'BEGIN { ORS = "" } { gsub(/\r/, "\\r"); if (NR > 1) print "\\n"; print }'
}

# jget <key>: a top-level scalar of the JSON on stdin ("" when missing)
jget() {
  case $JSON_TOOL in
    python3)
      python3 -c 'import json,sys
try:
    v = json.load(sys.stdin).get(sys.argv[1], "")
except Exception:
    v = ""
print(str(v).lower() if isinstance(v, bool) else ("" if v is None else v))' "$1"
      ;;
    jq)
      jq -r --arg k "$1" '.[$k] // empty | tostring' 2>/dev/null
      ;;
    *)
      sed -n "s/.*\"$1\":\"\\{0,1\\}\\([^,}\"]*\\).*/\\1/p" | head -n 1
      ;;
  esac
}

# the server speaks at most 2000 characters; longer text is cut with an ellipsis (here and, as a second line of defence, on the server)
truncate_text() {
  if command -v python3 >/dev/null 2>&1; then
    python3 -c 'import sys
t = sys.argv[1]
sys.stdout.write(t if len(t) <= 2000 else t[:1999] + "\u2026")' "$1"
  else
    # bytes, not characters: a safe upper bound; iconv -c drops a character cut in half
    n=$(printf '%s' "$1" | wc -c | tr -d ' ')
    if [ "$n" -le 2000 ]; then
      printf '%s' "$1"
    else
      printf '%s' "$1" | head -c 1990 | { iconv -c -f UTF-8 -t UTF-8 2>/dev/null || cat; }
      printf '…'
    fi
  fi
}

# ---- HTTP ---------------------------------------------------------------------------------------

need_config() {
  if [ -z "$AGENT_RADIO_URL" ] || [ -z "$AGENT_RADIO_KEY" ]; then
    say_err "not configured: set AGENT_RADIO_URL and AGENT_RADIO_KEY in $CONF_FILE (or run the installer again)"
    exit 1
  fi
}

# request <method> <path> [curl args...] -> sets HTTP_CODE and HTTP_BODY; returns 1 when the server cannot be reached, answers with a 5xx
# (Cloudflare 52x included) or does not answer with JSON: all of that counts as "offline". The key goes to curl through its config on stdin,
# so it never shows up in the process list.
request() {
  method=$1
  path=$2
  shift 2
  safe_key=$(printf '%s' "$AGENT_RADIO_KEY" | sed -e 's/\\/\\\\/g' -e 's/"/\\"/g')
  out=$(printf 'header = "Authorization: Bearer %s"\n' "$safe_key" |
    curl -sS -m "${AGENT_RADIO_TIMEOUT:-20}" -X "$method" -K - -w '\n%{http_code}' "$@" "$AGENT_RADIO_URL$path" 2>/dev/null) || return 1
  HTTP_CODE=$(printf '%s' "$out" | tail -n 1)
  HTTP_BODY=$(printf '%s' "$out" | sed '$d')
  case $HTTP_CODE in
    000 | '' | 5??) return 1 ;;
  esac
  case $HTTP_BODY in
    '{'*) ;;
    *) return 1 ;;
  esac
  return 0
}

# handles the answers every command shares; returns 0 when the caller should carry on (HTTP 200, or 202 for a queued message)
common_errors() {
  case $HTTP_CODE in
    200 | 202) return 0 ;;
    401)
      say_err "the server rejected the key (401): check AGENT_RADIO_KEY in $CONF_FILE"
      exit 1
      ;;
    429)
      echo "agent-radio: skipped (rate limited)"
      exit 0
      ;;
    502 | 503 | 504)
      echo "agent-radio: offline"
      exit 0
      ;;
    *)
      msg=$(printf '%s' "$HTTP_BODY" | jget message)
      say_err "request failed ($HTTP_CODE)${msg:+: $msg}"
      exit 1
      ;;
  esac
}

cmd_status() {
  need_config
  request GET /api/status || {
    echo "agent-radio: offline"
    exit 0
  }
  common_errors
  up=$(printf '%s' "$HTTP_BODY" | jget up)
  listeners=$(printf '%s' "$HTTP_BODY" | jget listeners)
  lang=$(printf '%s' "$HTTP_BODY" | jget lang)
  title=$(printf '%s' "$HTTP_BODY" | jget title)
  listening=$(printf '%s' "$HTTP_BODY" | jget listening)
  reconnecting=$(printf '%s' "$HTTP_BODY" | jget reconnecting)
  listeners=${listeners:-0}
  if [ "$up" = "true" ]; then echo "agent-radio: online"; else echo "agent-radio: offline"; fi
  echo "listeners: $listeners"
  # "listening: yes" also covers a listener who dropped a moment ago (a player reconnecting): messages are held for them
  if [ "$listening" = "true" ] || [ "$listeners" -gt 0 ] 2>/dev/null; then echo "listening: yes"; else echo "listening: no"; fi
  [ "$reconnecting" = "true" ] && echo "reconnecting: yes"
  echo "language: ${lang:-uk}"
  [ -n "$title" ] && echo "now playing: $title"
  exit 0
}

# wait_played <message id>: polls the delivery of a message for up to AGENT_RADIO_WAIT (60) seconds
wait_played() {
  deadline=$(($(date +%s) + ${AGENT_RADIO_WAIT:-60}))
  last=""
  while :; do
    if request GET "/api/messages/$1"; then
      case $HTTP_CODE in
        200)
          last=$(printf '%s' "$HTTP_BODY" | jget status)
          reason=$(printf '%s' "$HTTP_BODY" | jget reason)
          [ "$reason" = null ] && reason=""
          case $last in
            played)
              echo "agent-radio: played"
              return
              ;;
            skipped | failed)
              echo "agent-radio: not played: ${reason:-$last}"
              return
              ;;
          esac
          ;;
        404)
          echo "agent-radio: not played: unknown message"
          return
          ;;
      esac
    fi
    if [ "$(date +%s)" -ge "$deadline" ]; then
      echo "agent-radio: not played: ${last:-unknown} after ${AGENT_RADIO_WAIT:-60}s"
      return
    fi
    sleep 1
  done
}

cmd_say() {
  need_config
  wait=0
  if [ "${1:-}" = "--wait" ]; then
    wait=1
    shift
  fi
  if [ $# -gt 0 ] && [ "$1" != "-" ]; then
    text="$*"
  elif [ ! -t 0 ]; then
    text=$(cat)
  else
    say_err 'usage: agent-radio say "text"'
    exit 2
  fi
  if [ -z "$text" ]; then
    say_err "nothing to say"
    exit 2
  fi
  text=$(truncate_text "$text")
  payload=$(json_say "$(session_label)" "$(host_label)" "$text")
  request POST /api/say -H 'Content-Type: application/json' --data-binary "$payload" || {
    echo "agent-radio: offline"
    exit 0
  }
  common_errors
  status=$(printf '%s' "$HTTP_BODY" | jget status)
  case $status in
    aired) echo "agent-radio: aired" ;;
    queued) echo "agent-radio: queued (a slow voice is synthesizing, it goes on air when ready)" ;;
    waiting) echo "agent-radio: waiting for listener (held, it goes on air when they reconnect; dropped after 3 minutes)" ;;
    *) echo "agent-radio: skipped (nobody listening)" ;;
  esac
  if [ "$wait" = 1 ]; then
    case $status in
      aired | queued | waiting)
        id=$(printf '%s' "$HTTP_BODY" | jget id)
        [ -n "$id" ] && wait_played "$id"
        ;;
    esac
  fi
  exit 0
}

cmd_play() {
  need_config
  title=""
  while [ $# -gt 0 ]; do
    case $1 in
      --title)
        title=${2:-}
        shift 2
        ;;
      *) break ;;
    esac
  done
  file=${1:-}
  intro=${2:-}
  if [ -z "$file" ] || [ ! -r "$file" ]; then
    say_err 'usage: agent-radio play [--title T] <audio file> ["intro"]'
    exit 2
  fi
  set -- -F "file=@$file" --form-string "session=$(session_label)" --form-string "host=$(host_label)"
  [ -n "$title" ] && set -- "$@" --form-string "title=$title"
  [ -n "$intro" ] && set -- "$@" --form-string "intro=$intro"
  AGENT_RADIO_TIMEOUT="${AGENT_RADIO_PLAY_TIMEOUT:-300}" request POST /api/play "$@" || {
    echo "agent-radio: offline"
    exit 0
  }
  case $HTTP_CODE in
    413 | 415 | 400)
      msg=$(printf '%s' "$HTTP_BODY" | jget message)
      say_err "the server refused the file ($HTTP_CODE)${msg:+: $msg}"
      exit 1
      ;;
  esac
  common_errors
  status=$(printf '%s' "$HTTP_BODY" | jget status)
  if [ "$status" = "aired" ]; then
    echo "agent-radio: on air"
  elif [ "$status" = "waiting" ]; then
    echo "agent-radio: waiting for listener (held, it goes on air when they reconnect; dropped after 3 minutes)"
  else
    echo "agent-radio: saved to the history (nobody listening now)"
  fi
  exit 0
}

cmd_config() {
  echo "config file: $CONF_FILE"
  echo "url: ${AGENT_RADIO_URL:-(not set)}"
  if [ -n "$AGENT_RADIO_KEY" ]; then
    echo "key: $(printf '%s' "$AGENT_RADIO_KEY" | cut -c1-6)…(hidden)"
  else
    echo "key: (not set)"
  fi
  echo "session: $(session_label)"
  echo "host: $(host_label)"
  echo "json: $JSON_TOOL"
  exit 0
}

cmd=${1:-}
[ $# -gt 0 ] && shift
case $cmd in
  status) cmd_status ;;
  say) cmd_say "$@" ;;
  play) cmd_play "$@" ;;
  config) cmd_config ;;
  *)
    say_err 'usage: agent-radio status | say [--wait] "text" | play <file> ["intro"] | config'
    exit 2
    ;;
esac
